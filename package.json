{
  "name": "japofc-qr",
  "version": "1.0.0",
  "description": "Zero-dependency QR Code generator for Node.js, Bun, Deno and browsers - numeric, alphanumeric, byte and ECI segments, with SVG, terminal and canvas output.",
  "keywords": [
    "japofc-qr",
    "japofc",
    "qr",
    "qrcode",
    "qr-code",
    "qr-code-generator",
    "qrcode-generator",
    "qr-generator",
    "qr-code-generation",
    "qr-code-library",
    "qr-encoder",
    "qrcode-encoder",
    "generator",
    "encoder",
    "iso-18004",
    "error-correction",
    "reed-solomon",
    "alphanumeric",
    "numeric",
    "byte-mode",
    "eci",
    "barcode",
    "2d-barcode",
    "matrix-code",
    "svg",
    "qr-code-svg",
    "terminal",
    "qr-code-terminal",
    "canvas",
    "data-url",
    "typescript",
    "nodejs",
    "node",
    "deno",
    "bun",
    "browser",
    "esm",
    "commonjs",
    "cli",
    "command-line",
    "zero-dependency",
    "no-dependencies",
    "dependency-free",
    "lightweight",
    "isomorphic",
    "universal"
  ],
  "homepage": "https://github.com/japofc/japofc-qr#readme",
  "bugs": {
    "url": "https://github.com/japofc/japofc-qr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japofc/japofc-qr.git"
  },
  "license": "MIT",
  "author": {
    "name": "@japofc",
    "url": "https://github.com/japofc"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/japofc"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "japofc-qr": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:only": "node --test test/*.test.mjs",
    "coverage": "node --experimental-test-coverage --test test/*.test.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm run preflight && npm run test:only",
    "release": "npm version",
    "example": "node examples/node/quickstart.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "typescript": "^5.6.0"
  }
}
